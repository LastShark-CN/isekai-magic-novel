# 自动检测文本文件类型
* text=auto

# Markdown 文件使用 UTF-8 编码
*.md text eol=lf

# Python 脚本
*.py text eol=lf

# YAML 配置文件
*.yml text eol=lf
*.yaml text eol=lf

# JSON 配置文件
*.json text eol=lf

# 图片文件保持二进制
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.svg binary

# Windows 批处理文件
*.bat text eol=crlf
*.cmd text eol=crlf
